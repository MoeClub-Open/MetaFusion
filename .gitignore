# ==============================================================================
# MetaFusion .gitignore — 生产级忽略规则
# ==============================================================================

# --- 依赖 ---
node_modules/
.pnp/
.pnp.js
.pnpm-store/
# lock 文件：包管理器口径是 bun（见 package.json 的 packageManager），但只有主站的
# frontend/bun.lock 入库——服务器是现场构建镜像的，锁文件不入库意味着同一个提交每次
# 构建都可能解析出不同的传递依赖树（升级、恢复、回滚都受影响）。三个管理台的锁文件在
# 各自仓库里本来就在库（auth/storage 的 admin/bun.lock、community 的 admin/package-lock.json）。
bun.lockb
bun.lock
!frontend/bun.lock
yarn.lock
package-lock.json

# --- 构建产物 ---
.next/
out/
dist/
build/
.turbo/
.vercel/
.turbo
# Next.js 缓存
.next/cache/
# TypeScript 增量构建
*.tsbuildinfo
**/*.tsbuildinfo
tsconfig.tsbuildinfo

# Next 自动生成（可按需提交，此处默认忽略以保持干净）
**/next-env.d.ts

# --- 环境变量与敏感信息 ---
# 忽略所有真实环境配置，仅保留 .env.example 作为模板
.env
.env.local
.env.development
.env.development.local
.env.test.local
.env.production
.env.production.local
.env.*.local
!.env.example
# 本地生成的密钥（.env.example 教用 openssl 生成 jwt.pem，此类文件不要入库）
*.pem
*.key

# --- 日志 ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- 测试与覆盖率 ---
coverage/
.nyc_output/
.coverage/
junit.xml

# --- 系统与编辑器 ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# --- 本地开发日志（只在本机有意义，绝不入库）---
# 目录内含部署信息、子项目路径、服务器注意事项等敏感本地上下文，规则见 docs-local/README.md
docs-local/

# --- 各编辑器的私有工作区状态（不入库）---
.mimosa/
**/.mimosa/
.zcode/
.muse/
.claude/
.cursor/
.trae/

# --- 缓存 ---
.eslintcache
.stylelintcache
.cache/
.parcel-cache/

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
# 二进制与本地构建
backend/bin/
backend/vendor/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work
go.work.sum

# --- Docker ---
# 本地卷数据（若误放于仓库）
pg_data/
redis_data/
es_data/
minio_data/

# --- 一次性脚本（补数据 / 调试 / 模拟 / 远程运维）---
# 这些脚本只在本地对着实例跑一次或几次，接口与数据都会随时变，进版本库只会变成
# 过时的“可运行承诺”。需要时去本地文件或 docs-local 记录里找，不要提交。
# 长期存在的质量闸门（scripts/check_*.py|ts）不在此列，它们由 CI 执行。
scripts/data/
scripts/sim/
scripts/import_external.py
scripts/mirror_external_images.py
scripts/run_remote.py

# --- 临时与本地脚本产物 ---
tmp/
temp/
.tmp/
*.tmp
*.temp
# 本地数据库导出/核查 dump（不入库，如 db_works_dump.json）
*_dump.json
db_*.json
deploy/*.sql.bak


# --- 前端本地静态资源（按需）---
# frontend/public/covers/ 为种子数据，保持入库；如需本地生成大图请用 /tmp
.playwright-cli/
output/

# 注：一次性脚本的忽略规则见上面同一节，不要重复添加（2026-09-16 曾因两次追加留下重复块）。
/.agent-teams
